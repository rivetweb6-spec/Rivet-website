{
  "name": "river-company",
  "version": "0.1.0",
  "private": true,
  "description": "RIVET — River Company luxury digital flagship (web + api monorepo)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:web": "pnpm --filter @rivet/web dev",
    "dev:api": "pnpm --filter @rivet/api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @rivet/web build",
    "build:api": "pnpm --filter @rivet/api build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "smoke": "node scripts/smoke-test.mjs",
    "analyze": "pnpm --filter @rivet/web analyze",
    "contrast": "pnpm --filter @rivet/web contrast",
    "lighthouse": "pnpm --filter @rivet/web lhci",
    "db:generate": "pnpm --filter @rivet/api prisma:generate",
    "db:migrate": "pnpm --filter @rivet/api prisma:migrate",
    "db:seed": "pnpm --filter @rivet/api prisma:seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
