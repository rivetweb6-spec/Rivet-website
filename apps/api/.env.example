# --- Server ---

PORT=4000

NODE_ENV=development

# Local: http://localhost:3000
# Production: exact Vercel origin(s), comma-separated (no wildcards).
# Example: https://rivet.vercel.app,https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000



# --- Database (Supabase PostgreSQL) ---
#
# Supabase → Project Settings → Database → Connection string
# Use the "Session pooler" URI on IPv4-only networks (port 5432).
# URL-encode special characters in the password (e.g. ( → %28, ) → %29).

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"



# --- Auth ---

# Render: generated automatically for JWT_ACCESS_SECRET / JWT_REFRESH_SECRET

JWT_ACCESS_SECRET="change-me-access-secret"

JWT_REFRESH_SECRET="change-me-refresh-secret"

# Access token lifetime in seconds (8 hours). Admin CRUD refreshes via refresh token.
JWT_ACCESS_TTL=28800

JWT_REFRESH_TTL=604800



# --- Media uploads ---
#
# Local file uploads work without Cloudinary: files are stored on disk and
# served at GET /api/uploads/files/:filename.
# Optional: set Cloudinary to offload media to a CDN (recommended in production
# on ephemeral hosts such as Render's free plan).

CLOUDINARY_CLOUD_NAME=""

CLOUDINARY_API_KEY=""

CLOUDINARY_API_SECRET=""

# Directory for locally stored uploads (defaults to ./uploads)
# UPLOAD_DIR=/var/data/uploads

# Public origin of this API (no /api suffix). Used in stored image URLs.
# Local: http://localhost:4000
# Render: https://your-api.onrender.com
# When empty, derived from the incoming request.
PUBLIC_API_URL=""



# --- Seed admin (run once via Render shell: pnpm db:seed) ---

SEED_ADMIN_EMAIL="admin@rivet.com"

SEED_ADMIN_PASSWORD="Admin123!"



# --- Monitoring: Sentry (leave empty to disable) ---

SENTRY_DSN=""

SENTRY_ENVIRONMENT="development"

# Fraction of transactions traced for performance monitoring (0.0 - 1.0)

SENTRY_TRACES_SAMPLE_RATE="0.1"

