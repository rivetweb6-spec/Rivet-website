// RIVET — River Company data model
// PostgreSQL + Prisma. English-first; content fields are structured so a
// Translation layer can be added later without breaking relations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum DemoStatus {
  NEW
  CONTACTED
  SCHEDULED
  COMPLETED
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  order       Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  shortDescription String?
  description     String?
  brand           String?
  countryOfOrigin String?
  specs           Json?          // [{ label, value }]
  features        Json?          // string[]
  images          ProductImage[]
  featured        Boolean        @default(false)
  status          ContentStatus  @default(PUBLISHED)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([categoryId])
  @@index([featured])
  @@index([status])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String? // Cloudinary public id for deletion
  alt       String?
  order     Int     @default(0)

  @@index([productId])
}

model Service {
  id        String        @id @default(cuid())
  title     String
  slug      String        @unique
  narrative String
  icon      String?
  image     String?
  order     Int           @default(0)
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model NewsArticle {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String?
  body        String        // rich-text HTML (Tiptap)
  coverImage  String?
  category    String?
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([category])
}

model DemoRequest {
  id              String     @id @default(cuid())
  fullName        String
  company         String?
  email           String
  phone           String
  productInterest String
  message         String?
  status          DemoStatus @default(NEW)
  adminNotes      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Singleton (single row) — company profile.
model CompanyInfo {
  id             String   @id @default("company")
  history        String?
  vision         String?
  mission        String?
  coreValues     Json?    // string[]
  timeline       Json?    // [{ year, title, description }]
  achievements   Json?    // string[]
  certifications Json?    // string[]
  updatedAt      DateTime @updatedAt
}

// Singleton (single row) — contact + social.
model ContactInfo {
  id        String   @id @default("contact")
  address   String?
  phone     String?
  email     String?
  whatsapp  String?
  facebook  String?
  linkedin  String?
  telegram  String?
  mapLat    Float?
  mapLng    Float?
  updatedAt DateTime @updatedAt
}

// Singleton — public homepage hero + intro content.
model HomePageContent {
  id                 String   @id @default("home")
  eyebrow            String?
  headline           String?
  headlineAccent     String?
  subheadline        String?
  heroImage          String?
  introEyebrow       String?
  introTitle         String?
  introBody          String?
  introBodySecondary String?
  introImage         String?
  updatedAt          DateTime @updatedAt
}
