// RIVET — River Company data model
// PostgreSQL + Prisma. English-first; content fields are structured so a
// Translation layer can be added later without breaking relations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum QuotationStatus {
  NEW
  UNDER_REVIEW
  CONTACTED
  QUOTATION_SENT
  APPROVED
  REJECTED
  COMPLETED
}

enum CertificateKind {
  CERTIFICATE
  PORTFOLIO
}

enum TeamSection {
  LEADERSHIP
  ENGINEERING
  TEAM
}

enum GalleryCategory {
  PHOTOS
  ACTIVITIES
  PROJECTS
  EVENTS
  OTHER
}

enum VacancyStatus {
  DRAFT
  OPEN
  CLOSED
}

enum ApplicationStatus {
  NEW
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  OFFERED
  REJECTED
  HIRED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String?
  image          String?
  order          Int       @default(0)
  faqs           Json? // [{ question, answer }]
  seoTitle       String?
  seoDescription String?
  primaryKeyword String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  canonicalUrl   String?
  noIndex        Boolean   @default(false)
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Product {
  id               String         @id @default(cuid())
  name             String
  slug             String         @unique
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  shortDescription String?
  description      String?
  brand            String?
  countryOfOrigin  String?
  specs            Json? // [{ label, value }]
  features         Json? // string[]
  images           ProductImage[]
  featured         Boolean        @default(false)
  status           ContentStatus  @default(PUBLISHED)
  seoTitle         String?
  seoDescription   String?
  primaryKeyword   String?
  ogTitle          String?
  ogDescription    String?
  ogImage          String?
  canonicalUrl     String?
  noIndex          Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([categoryId])
  @@index([featured])
  @@index([status])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String? // Cloudinary public id for deletion
  alt       String?
  order     Int     @default(0)

  @@index([productId])
}

model Service {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  narrative      String
  icon           String?
  image          String?
  order          Int           @default(0)
  status         ContentStatus @default(PUBLISHED)
  faqs           Json? // [{ question, answer }]
  seoTitle       String?
  seoDescription String?
  primaryKeyword String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  canonicalUrl   String?
  noIndex        Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Certificate {
  id          String          @id @default(cuid())
  title       String
  description String?
  image       String?
  images      Json? // string[] additional images (portfolio)
  kind        CertificateKind @default(CERTIFICATE)
  order       Int             @default(0)
  status      ContentStatus   @default(PUBLISHED)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@index([order])
  @@index([kind])
}

model TeamMember {
  id        String        @id @default(cuid())
  fullName  String
  position  String
  bio       String?
  photo     String?
  email     String?
  phone     String?
  linkedin  String?
  section   TeamSection   @default(TEAM)
  order     Int           @default(0)
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([section])
  @@index([order])
}

model GalleryImage {
  id          String          @id @default(cuid())
  title       String
  description String?
  image       String
  category    GalleryCategory @default(PHOTOS)
  order       Int             @default(0)
  status      ContentStatus   @default(PUBLISHED)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@index([category])
  @@index([order])
}

model NewsArticle {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String?
  body           String // rich-text HTML (Tiptap)
  coverImage     String?
  category       String?
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  primaryKeyword String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  canonicalUrl   String?
  noIndex        Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([category])
}

model PageSeo {
  id             String   @id @default(cuid())
  pageKey        String   @unique // home | company | certificate-portfolio | team | gallery | services | news | contact | request-quotation | products | careers
  seoTitle       String?
  seoDescription String?
  primaryKeyword String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  canonicalUrl   String?
  noIndex        Boolean  @default(false)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model QuotationRequest {
  id              String          @id @default(cuid())
  fullName        String
  company         String?
  email           String
  phone           String
  productInterest String
  productId       String?
  productName     String?
  productSlug     String?
  productImage    String?
  quantity        String?
  message         String?
  status          QuotationStatus @default(NEW)
  adminNotes      String?
  readAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([readAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Vacancy {
  id             String           @id @default(cuid())
  title          String
  slug           String           @unique
  department     String?
  location       String?
  employmentType String? // Full-time | Part-time | Contract | Internship
  description    String // rich-text HTML
  requirements   String // rich-text HTML
  deadline       DateTime
  status         VacancyStatus    @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  primaryKeyword String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  canonicalUrl   String?
  noIndex        Boolean          @default(false)
  applications   JobApplication[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([deadline])
}

model JobApplication {
  id             String            @id @default(cuid())
  vacancyId      String
  vacancy        Vacancy           @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  fullName       String
  email          String
  phone          String
  coverLetter    String?
  cvPublicId     String // local:filename or Cloudinary public id — never expose publicly
  cvOriginalName String
  cvMimeType     String
  status         ApplicationStatus @default(NEW)
  adminNotes     String?
  readAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([vacancyId])
  @@index([status])
  @@index([createdAt])
  @@index([readAt])
}

// Singleton (single row) — company profile.
model CompanyInfo {
  id             String   @id @default("company")
  history        String?
  vision         String?
  mission        String?
  coreValues     Json? // string[]
  timeline       Json? // [{ year, title, description }]
  achievements   Json? // string[]
  certifications Json? // string[]
  updatedAt      DateTime @updatedAt
}

// Singleton (single row) — contact + social.
model ContactInfo {
  id        String   @id @default("contact")
  address   String?
  phone     String?
  email     String?
  whatsapp  String?
  facebook  String?
  linkedin  String?
  telegram  String?
  mapLat    Float?
  mapLng    Float?
  updatedAt DateTime @updatedAt
}

// Singleton — public homepage hero + intro content.
model HomePageContent {
  id                 String   @id @default("home")
  eyebrow            String?
  headline           String?
  headlineAccent     String?
  subheadline        String?
  heroImage          String?
  introEyebrow       String?
  introTitle         String?
  introBody          String?
  introBodySecondary String?
  introImage         String?
  gmName             String?
  gmPosition         String?
  gmPhoto            String?
  gmMessage          String?
  engName            String?
  engPosition        String?
  engPhoto           String?
  engMessage         String?
  updatedAt          DateTime @updatedAt
}
