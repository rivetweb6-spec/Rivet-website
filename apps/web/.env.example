# Public site URL (canonical / OG / sitemap / robots host)
# Use the real production HTTPS origin for Search Console & social previews.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://rivet.example.com



# Express API base (includes /api prefix)
# Required on Vercel at build time — browser login is proxied through Next `/api`.
# File uploads POST directly to this origin (bypasses the Vercel body-size limit).
# Local: http://localhost:4000/api
# Render production: https://rivet-api.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Optional override for the Next.js rewrite proxy target (defaults to NEXT_PUBLIC_API_URL)
# API_PROXY_TARGET=https://rivet-api.onrender.com/api



# --- Monitoring: Sentry (leave empty to disable) ---

# DSN is public/client-safe and used on both server and browser.

NEXT_PUBLIC_SENTRY_DSN=""

SENTRY_ENVIRONMENT="development"

# Fraction of transactions traced for performance monitoring (0.0 - 1.0)

NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"

# Only needed in CI/CD to upload source maps (Settings → Auth Tokens in Sentry).

SENTRY_ORG=""

SENTRY_PROJECT=""

SENTRY_AUTH_TOKEN=""

