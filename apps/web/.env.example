# Public site URL (canonical / OG / sitemap / robots host)
# Use the real production HTTPS origin for Search Console & social previews.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://rivetplc.com

# Search engine ownership verification (meta-tag method). Paste only the code.
# Google Search Console → Add property → URL prefix → HTML tag → content="..."
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# Bing Webmaster Tools → HTML Meta Tag → msvalidate.01 content="..."
NEXT_PUBLIC_BING_SITE_VERIFICATION=""



# Express API base (includes /api prefix)
# Required for production builds — the browser calls same-origin `/api`, which Next proxies here.
# File uploads POST directly to this origin (bypasses the proxy body-size limit).
# Local: http://localhost:4000/api
# Production: https://api.your-domain.com/api (wherever the API is hosted)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Optional override for the Next.js rewrite proxy target (defaults to NEXT_PUBLIC_API_URL)
 API_PROXY_TARGET=http://localhost:4000/api



# --- Monitoring: Sentry (leave empty to disable) ---

# DSN is public/client-safe and used on both server and browser.

NEXT_PUBLIC_SENTRY_DSN=""

SENTRY_ENVIRONMENT="development"

# Fraction of transactions traced for performance monitoring (0.0 - 1.0)

NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"

# Only needed in CI/CD to upload source maps (Settings → Auth Tokens in Sentry).

SENTRY_ORG=""

SENTRY_PROJECT=""

SENTRY_AUTH_TOKEN=""

